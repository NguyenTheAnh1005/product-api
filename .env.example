PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/productdb
MONGODB_URI_CONTAINER=mongodb://mongo:27017/productdb
MONGO_PORT=27017
# Compose host port; container always listens on 3000
API_PORT=3000
# Required only for docker-compose-prod.yaml; use namespace/product-api:commit-sha
PRODUCT_IMAGE=
GITHUB_REPOSITORY=YOUR_GITHUB_USERNAME/product-api
DOCKERHUB_NAMESPACE=YOUR_DOCKERHUB_USERNAME
CD_POLL_SECONDS=300
# Optional external MongoDB for integration tests; records are isolated and cleaned
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/product_api_test
